<?xml version="1.0" encoding="utf-8"?>
<!-- Invisible spacer used as the LinearLayout divider between mode bar entries (see
     android:showDividers on mode_bar in activity_main.xml): one gap between neighbours, none
     at the ends, whatever the number of entries. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size android:width="8dp" android:height="8dp" />
    <solid android:color="@android:color/transparent" />
</shape>
