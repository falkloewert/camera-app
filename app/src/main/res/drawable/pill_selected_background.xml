<?xml version="1.0" encoding="utf-8"?>
<!-- Pillen-/Stadion-Form hinter dem aktiven Eintrag im Modus-Karussell, hinter der aktiven
     Zoom-Stufe und hinter den Zoom-/Regler-Abzeichen. Seit Schritt N der feste Salbei-Akzent
     statt des frueheren Weiss (ui-spezifikation.md 7.3); darauf steht dunkle Schrift
     (md_dark_on_accent, gesetzt in ZoomStepper.applyPillStyle). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid
        android:color="@color/md_dark_accent"
        />
    <corners android:radius="9999dp" />
</shape>
