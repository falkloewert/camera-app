<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="seekbar_background">#30000000</color>
    <color name="icons_background">#20000000</color> <!-- when used as background color for imagebutton, the rgb color seems to be ignored for Android 6 onwards, but still relevant for older versions -->
    <color name="icons_background_tint">#ff000000</color>
    <!-- Auslöser-Zeile (docs/design-reference/ui-spezifikation.md 7.2): Kern reinweiß im
         Fotomodus, Signalrot im Videomodus (Detail-Spec 1, "Videomodus-Akzent"); früher war
         der Auslöser blau (#2F9CF2). Ring, Kamera-Wechsel-Squircle und Galerie-Rahmen sind
         in der Referenz ein und dasselbe Material: Schwarz mit 60 % Deckkraft - aus dem
         Referenz-Screenshot an einem dunklen und einem hellen Hintergrund gelöst
         (Audit-Schritt 1, 2026-09-17), NICHT das rgba(255,255,255,0.12) der Detail-Spec,
         das über dem Sucherbild heller statt dunkler wäre. -->
    <color name="shutter_icon">#FFFFFF</color>
    <color name="shutter_icon_video">#E53935</color>
    <color name="shutter_row_scrim">#99000000</color>
    <!-- Foto/Video-Umschalter (ui/PhotoVideoSwitch), Farben aus dem Referenz-Screenshot:
         dunkelgraue Pille, weißer Knopf, Symbol auf dem Knopf fast schwarz, das andere weiß. -->
    <color name="photo_video_switch_pill">#333333</color>
    <color name="photo_video_switch_knob">#FFFFFF</color>
    <color name="photo_video_switch_glyph_on_knob">#1B1B1B</color>
    <color name="photo_video_switch_glyph">#FFFFFF</color>
    <color name="scrollview">#999999</color>

    <!-- Material 3 dark camera chrome (SPEC.md 4.5): dark neutral surface (not pure black),
         near-white text, muted gray for secondary text, selection via full white fill rather
         than a saturated accent, gold focus ring. Approximate values from the Pixel Camera
         screenshot analysis - can be refined once real M3 components land in phase 2/3. -->
    <color name="md_dark_surface">#000000</color>
    <color name="md_dark_surface_variant">#2C2C2C</color>
    <color name="md_dark_on_surface">#F2F2F2</color>
    <color name="md_dark_on_surface_variant">#C4C7C5</color>
    <!-- Der aktive Akzent: fester Salbei-Ton statt des frueheren #F2F2F2 und statt Material-You-
         DynamicColors - das Theme ist seit Phase 1 fest dunkel, die App soll immer gleich
         aussehen (Schritt N, ui-spezifikation.md 7.3). Er fuellt Auswahl-Flaechen (aktive
         Zoom-Stufe, Modus-Karussell, Blaetter-Knoepfe), nicht Text; auf ihm steht dunkle
         Schrift. Das frueher hier definierte, nie benutzte md_dark_primary #B0A695 ist weg. -->
    <color name="md_dark_accent">#D3E8D8</color>
    <color name="md_dark_on_accent">#000000</color>
    <!-- Inaktive Eintraege des Modus-Karussells - dunkler als der uebrige Sekundaertext
         (md_dark_on_surface_variant), weil die Leiste ueber dem Sucherbild liegt. -->
    <color name="mode_bar_inactive">#8E918F</color>
    <!-- Alle Ueberlagerungs-Flaechen ueber der Vorschau: Zoom-Pille samt Zoom-Badge, Massband-
         Behaelter im Pro-Blatt, Chips der Tempo-Leiste, Staerke-Leiste. rgba(20,20,20,0.65) aus
         ui-spezifikation.md 7.3, ohne Blur - echter Milchglas-Blur braucht einen
         Snapshot-Umweg und ginge vor API 31 nicht (Recherche 2026-09-17, siehe 7.3).
         Deutlich deckender als icons_background (das ist fuer Icon-Buttons bewusst fast
         durchsichtig), sonst sind die inaktiven Stufen ueber hellen Motiven nicht lesbar. -->
    <color name="zoom_stepper_background">#A6141414</color>
    <!-- Feinjustier-Rad (ui/ZoomWheel), Detail-Spec Abschnitt 5: Zahlen in 60 % Weiss
         (rgba(255,255,255,0.6)), die Striche in derselben Farbe, der statische Zeiger in
         der Mitte reinweiss. -->
    <color name="zoom_wheel_tick">#99FFFFFF</color>
    <color name="zoom_wheel_pointer">#FFFFFF</color>

    <!-- Einstellungen-Blatt (ui/SettingsSheet), alle Werte aus dem Referenz-Screenshot
         gemessen (Kickoff redesign-einstellungen-blatt-benchmark.md 2.2/2.3). -->
    <color name="settings_sheet_panel">#EB000000</color>
    <color name="settings_sheet_handle">#919191</color>
    <color name="settings_sheet_outline">#919191</color>
    <color name="settings_sheet_tab_active">#FFFFFF</color>
    <color name="settings_sheet_tab_active_text">#1B1B1B</color>
    <color name="settings_sheet_tab_inactive">#2A2A2A</color>
    <color name="settings_sheet_tab_inactive_text">#E2E2E2</color>
    <color name="settings_sheet_label">#E2E2E2</color>
    <color name="settings_sheet_value">#FFFFFF</color>
    <color name="settings_sheet_button">#1F1F1F</color>
    <color name="settings_sheet_button_glyph">#E2E2E2</color>
    <color name="settings_sheet_button_selected">@color/md_dark_accent</color>
    <color name="settings_sheet_button_glyph_selected">@color/md_dark_on_accent</color>
</resources>
