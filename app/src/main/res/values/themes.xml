<resources>

    <!-- Application theme, Material 3 foundation (SPEC.md 4.5).
         Parent is Theme.Material3.Dark.NoActionBar, not the .DayNight variant: the camera
         chrome must stay fixed dark regardless of the system theme, like the real Pixel
         Camera app - it should not follow the phone's light/dark setting. -->
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <!-- Ohne diese Zeile legt Android das Fenster unterhalb der Display-Aussparung an: Kopfzeile
             und Sucher sassen 68 dp (153 px) zu tief, der 16:9-Sucher endete bei 898 dp statt bei
             829 dp wie in der Referenz (Messung 2026-09-23). shortEdges laesst die App wie Googles
             Kamera bis in die Aussparung zeichnen. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:imageButtonStyle">@style/image_button</item>
        <item name="android:windowBackground">@color/md_dark_surface</item>

        <item name="colorSurface">@color/md_dark_surface</item>
        <item name="colorOnSurface">@color/md_dark_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_dark_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_dark_on_surface_variant</item>
        <item name="colorPrimary">@color/md_dark_accent</item>
        <item name="colorOnPrimary">@color/md_dark_on_accent</item>

        <!-- Roboto Flex (SPEC 4.5, feste Entscheidung; OFL, Lizenztext liegt als
             roboto_flex_OFL.txt im Repo-Wurzelverzeichnis). Als Theme-Vorgabe, damit sie
             app-weit gilt und nicht an jedem TextView einzeln steht. Gewicht 600 statt
             BOLD/700 setzt der Code ueber ui/AppFont. -->
        <item name="android:fontFamily">@font/roboto_flex</item>
        <item name="fontFamily">@font/roboto_flex</item>
    </style>

</resources>
