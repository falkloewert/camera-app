    <!-- Fixed 1dp size, not 0dp: under RelativeLayout, 0dp was a literal zero size, but
         ConstraintLayout treats 0dp as "match constraints" - with only one constraint per axis
         (see MainUI.layoutUI()) that would make it expand to fill all remaining space instead
         of collapsing to ~nothing, corrupting every icon chained off it. -->
    <View
        android:id="@+id/gui_anchor"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:padding="1dp"
        android:scaleType="fitCenter"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <!-- padding set to 0 to maximise the size of the thumbnail shown; background is transparent for
        when the thumbnail aspect ratio doesn't match the button aspect ratio, to avoid showing a
        shaded background
        -->
    <!-- Galerie-Miniatur: 56-dp-Squircle links vom Auslöser (Referenz, ui-spezifikation.md 1b).
         Das Padding lässt 2 dp des Squircle-Hintergrunds als Rahmen um das Bild stehen, wie im
         Screenshot vermessen; das Bild selbst wird per clipToOutline (MainActivity.onCreate)
         auf die Squircle-Form beschnitten. -->
    <ImageButton
