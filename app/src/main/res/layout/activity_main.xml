<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity" >

    <!-- The camera preview is the one view here that is never repositioned at runtime by
         MainUI.layoutUI() - it just needs to stay centred, like RelativeLayout's
         layout_centerInParent used to give it (ConstraintLayout centres a view by connecting
         both opposing sides on each axis to the parent). -->
    <FrameLayout
        android:id="@+id/preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <!-- Selfie-Beleuchtung (Frontkamera, Foto und Video): fuellt die schwarzen Flaechen ueber und
         unter dem Vorschaubild weiss (Kickoff Video-Blatt Runde 2, Punkt 3; seit 2026-09-21 auch
         im Foto-Blatt statt des Frontblitzes). Sie liegt direkt hinter
         der Vorschau und vor allen Bedienelementen - die bleiben also obenauf - und wird von
         MainUI.layoutUI() nie angefasst (bildschirmfuellend per Constraints). Nicht clickable,
         damit Beruehrungen zum Sucher darunter durchfallen. -->
    <net.sourceforge.opencamera.ui.SelfieLightView
        android:id="@+id/selfie_light"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <!-- Kopfzeile (Schritt C, SPEC 4.5): ein 70,7 dp hohes, rein schwarzes Band über dem Sucher,
         darin links der Auflösungs-Chip, rechts daneben das Makro-Symbol. Alle Maße sind aus dem
         Screenrecord der Pixel-App gemessen (2,25 px/dp) und stehen in
         docs/design-reference/pixel-kopfzeile-beschreibung.md; die Maße setzt MainUI.layoutHeader()
         zur Laufzeit, hier stehen nur die Rückfallwerte. Kein Verlauf und kein Scrim - das Band
         ist #000000, die Chips sind invertiert. Das "?" der Referenz entfällt (Falk 2026-09-21):
         es ist Googles Hilfe-Symbol, der Record zeigt keine Aktion darauf. -->
    <View
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="71dp"
        android:background="@android:color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <!-- Der Chip trägt unsere Auflösung (Foto: "12" / "MP" zweizeilig, Video: "4K" / "FHD"),
         weißer Block mit schwarzer Schrift. Größe und Text setzt MainUI.layoutHeader(), weil
         die Beschriftung mit dem Modus wechselt. -->
    <TextView
        android:id="@+id/header_chip"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:background="@drawable/header_chip_background"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@android:color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <!-- Der zweite Chip, die Bildrate ("30", "60"), nur im Video. Er sitzt in der Lücke, in der
         die Referenz ihr Makrofokus-Symbol hat (linker Rand 80,9 dp, gemessen); das Symbol selbst
         gibt es hier nicht, "Makro" ist in dieser App eine Linse, kein Zustand (Falk 2026-09-22:
         dann lieber gar keins). Getrennt vom Auflösungs-Chip, weil im Video beide unabhängig
         wandern (Falk 2026-09-22: "fps muss separat sein weil es ja viele Kombinationen gibt").
         Text und Sichtbarkeit setzt MainUI.layoutHeader(). -->
    <TextView
        android:id="@+id/header_fps"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:background="@drawable/header_chip_background"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@android:color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <!-- Die Zustandsanzeigen der Kopfzeile: Blitz, RAW, GPS, Ausrichtungssperre, Textstempel.
         Sie sind das, was von der alten Icon-Leiste geblieben ist (SPEC 4.5, Schritt C) - die
         uebrigen Icons waren entweder doppelt oder gehoeren in die Einstellungen. Die Reihe sitzt
         rechts im Band; welche Anzeige an ist, entscheidet ui/OnScreenIcons. Die Icons sind
         16-dp-Glyphen (32-dp-Bild mit 8 dp Polster) und tragen das Regelmaess der alten Leiste
         weiter; das Band selbst ist schwarz, darum hier keine eigene Fuellung. -->
    <LinearLayout
        android:id="@+id/header_indicators"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" >

        <ImageButton
            android:id="@+id/cycle_raw"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/cycle_raw"
            app:srcCompat="@drawable/raw_off_icon"
            android:background="@null"
            android:visibility="gone"
            android:onClick="clickedCycleRaw"
            />

        <ImageButton
            android:id="@+id/cycle_flash"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/cycle_flash"
            app:srcCompat="@drawable/flash_off"
            android:background="@null"
            android:visibility="gone"
            android:onClick="clickedCycleFlash"
            />

        <ImageButton
            android:id="@+id/store_location"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/preference_location_enable"
            app:srcCompat="@drawable/ic_gps_fixed_white_48dp"
            android:background="@null"
            android:visibility="gone"
            android:onClick="clickedStoreLocation"
            />

        <ImageButton
            android:id="@+id/cycle_lock_orientation"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/cycle_lock_orientation"
            app:srcCompat="@drawable/mobile_unlock_48px"
            android:background="@null"
            android:visibility="gone"
            android:onClick="clickedCycleLockOrientation"
            />

        <ImageButton
            android:id="@+id/text_stamp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/preference_textstamp_summary"
            app:srcCompat="@drawable/baseline_text_fields_white_48"
            android:background="@null"
            android:visibility="gone"
            android:onClick="clickedTextStamp"
            />
    </LinearLayout>

    <!-- Everything below this point is positioned at runtime by MainUI.layoutUI() (using
         ConstraintSet) - one fixed portrait arrangement, the window never rotates (see the
         rotation model in docs/design-reference/ui-spezifikation.md section 2). The
         app:layout_constraint* attributes here are only a fallback so nothing is flagged as
         "unconstrained" in the layout editor; they're overwritten before the first frame is
         ever shown, same as these views simply had no position at all under the old
         RelativeLayout (which also defaults unconstrained views to the top-left corner). -->

    <!-- Auslöser: der Ring ist der Hintergrund (shutter_ring.xml, 86 dp), den Kern (Scheibe
         bzw. Stopp-Quadrat) zeichnet ui/ShutterButton zur Laufzeit und zentriert ihn über
         scaleType=center. Die 100 dp bleiben als Touch-Fläche. Kein stateListAnimator: das
         Tap-Feedback ist eine Feder in ShutterButton. -->
    <ImageButton
        android:id="@+id/take_photo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:scaleType="center"
        android:contentDescription="@string/take_photo"
        android:onClick="clickedTakePhoto"
        android:background="@drawable/shutter_ring"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <!-- Kamera-Wechsel: 56-dp-Squircle rechts vom Auslöser, Pfeil-Glyph 24 dp. Die PNG-Grafik
         hat ringsum Leerraum (der Glyph füllt 66 von 96 px), darum 35 dp Bildfläche mit 10,5 dp
         Padding statt 24 dp mit 16 dp. Kein stateListAnimator: die Rückmeldung beim Antippen
         ist die halbe Drehung des Icons (MainUI.animateSwitchCamera()), ein gleichzeitiges
         Aufblähen hat die Referenz nicht. -->
    <ImageButton
        android:id="@+id/switch_camera"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:padding="10.5dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/switch_to_front_camera"
        app:srcCompat="@drawable/switch_camera"
        android:onClick="clickedSwitchCamera"
        android:background="@drawable/squircle_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <ImageButton
        android:id="@+id/switch_multi_camera"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:paddingTop="12dp"
        android:paddingBottom="18dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/switch_multi_camera"
        app:srcCompat="@drawable/baseline_add_a_photo_white_48"
        android:onClick="clickedSwitchMultiCamera"
        android:stateListAnimator="@animator/button_animation"
        android:background="@drawable/circle_background"
        android:backgroundTint="@color/icons_background_tint"
        android:backgroundTintMode="src_in"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <!-- In Panorama mode, this row replaces switch_multi_camera: instead of one icon that
         toggles/opens a dialog, the user directly taps "1x" or the wide-angle lens - since
         Panorama only ever needs those two lenses (zoom is disabled in Panorama, see
         MyApplicationInterface.allowZoom()). The two buttons are grouped in one LinearLayout so
         they can be positioned as a single centred unit (see MainUI.java) - centering two
         independent siblings on a third view isn't straightforward, but a wrapping
         LinearLayout sidesteps that. The gap between the two buttons is a divider
         (panorama_lens_gap.xml). The buttons zero their padding and minimum size because under
         the Material 3 theme a <Button> inflates as a MaterialButton with 24dp side padding,
         which wrapped "1x" onto two lines inside the 60dp circle (same fix as in
         ZoomStepper.createStepButton()). -->
    <LinearLayout
        android:id="@+id/panorama_lens_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:divider="@drawable/panorama_lens_gap"
        android:showDividers="middle"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/panorama_lens_wide"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textColor="@android:color/white"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:contentDescription="@string/panorama_lens_wide"
            android:text="@string/panorama_lens_wide"
            android:onClick="clickedPanoramaLensWide"
            android:stateListAnimator="@animator/button_animation"
            android:background="@drawable/circle_background"
            android:backgroundTint="@color/icons_background_tint"
            android:backgroundTintMode="src_in"
            />

        <Button
            android:id="@+id/panorama_lens_1x"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textColor="@android:color/white"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:contentDescription="@string/panorama_lens_main"
            android:text="@string/panorama_lens_main"
            android:onClick="clickedPanoramaLens1x"
            android:stateListAnimator="@animator/button_animation"
            android:background="@drawable/circle_background"
            android:backgroundTint="@color/icons_background_tint"
            android:backgroundTintMode="src_in"
            />
    </LinearLayout>

    <ImageButton
        android:id="@+id/pause_video"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/pause_video"
        app:srcCompat="@drawable/ic_pause_circle_outline_white_48dp"
        android:onClick="clickedPauseVideo"
        android:background="@null"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <ImageButton
        android:id="@+id/cancel_panorama"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/cancel_panorama"
        app:srcCompat="@drawable/baseline_close_white_48"
        android:onClick="clickedCancelPanorama"
        android:stateListAnimator="@animator/button_animation"
        android:background="@null"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <!-- Monochrom (dunkler Kreis + weißes Symbol) wie switch_camera und wie die
         Pixel-Kamera-Referenz - vorher ein blaues PNG (@drawable/take_video). -->
    <!-- Seit Audit-Schritt 1 unsichtbar: seinen Platz links vom Auslöser hat die Galerie, Foto
         <-> Video wird wie in der Referenz über die Moduswahl-Leiste umgeschaltet (und später
         über die Pille in der untersten Zeile, Audit-Schritt 2). Der Button bleibt nur im
         Layout, weil die Instrumented-Tests und setTakePhotoIcon() ihn noch ansprechen. -->
    <ImageButton
        android:id="@+id/switch_video"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/switch_to_video"
        app:srcCompat="@drawable/ic_videocam_white_48dp"
        android:onClick="clickedSwitchVideo"
        android:background="@drawable/circle_background"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <!-- need large padding than pause_video, to reflect that pause_video icon has padding built into the png image -->
    <ImageButton
        android:id="@+id/take_photo_when_video_recording"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/take_photo"
        app:srcCompat="@drawable/video_snapshot_disc"
        android:stateListAnimator="@animator/button_animation"
        android:onClick="clickedTakePhotoVideoSnapshot"
        android:background="@null"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <!-- n.b., layout_marginLeft set programmatically in DrawPreview -->
    <SeekBar
        android:id="@+id/focus_seekbar"
        android:contentDescription="@string/focus_distance"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:visibility="gone"
        android:background="@color/seekbar_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <!-- n.b., layout_marginLeft set programmatically in DrawPreview -->
    <SeekBar
        android:id="@+id/focus_bracketing_target_seekbar"
        android:contentDescription="@string/focus_bracketing_target_distance"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:visibility="gone"
        android:background="@color/seekbar_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <!-- padding set to 0 to maximise the size of the thumbnail shown; background is transparent for
        when the thumbnail aspect ratio doesn't match the button aspect ratio, to avoid showing a
        shaded background
        -->
    <!-- Galerie-Miniatur: 56-dp-Squircle links vom Auslöser (Referenz, ui-spezifikation.md 1b).
         Das Padding lässt 2 dp des Squircle-Hintergrunds als Rahmen um das Bild stehen, wie im
         Screenshot vermessen; das Bild selbst wird per clipToOutline (MainActivity.onCreate)
         auf die Squircle-Form beschnitten. -->
    <ImageButton
        android:id="@+id/gallery"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:padding="2dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/gallery"
        app:srcCompat="@drawable/baseline_photo_library_white_48"
        android:background="@drawable/squircle_background"
        android:onClick="clickedGallery"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <!--<ImageButton
        android:id="@+id/switch_video"
        android:layout_width="@dimen/onscreen_button_size"
        android:layout_height="@dimen/onscreen_button_size"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/switch_to_video"
        android:src="@drawable/switch_video"
        android:background="@color/icons_background"
        android:backgroundTint="@color/icons_background_tint"
        android:backgroundTintMode="src_in"
        android:onClick="clickedSwitchVideo"
        />-->

    <!--<ImageButton
        android:id="@+id/switch_camera"
        android:layout_width="@dimen/onscreen_button_size"
        android:layout_height="@dimen/onscreen_button_size"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/switch_to_front_camera"
        android:src="@drawable/baseline_switch_camera_white_48"
        android:background="@color/icons_background"
        android:backgroundTint="@color/icons_background_tint"
        android:backgroundTintMode="src_in"
        android:onClick="clickedSwitchCamera"
        />-->

    <!-- sliders_container is only ever centred in the parent (its position never changes at
         runtime - only its translationX/Y, set in MainUI.layoutUI()); the nested RelativeLayouts
         inside it are untouched by the root layout's type and keep working exactly as before. -->
    <LinearLayout
        android:id="@+id/sliders_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/seekbar_background"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <RelativeLayout
            android:id="@+id/iso_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            >

            <RelativeLayout
                android:id="@+id/iso_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                >
            </RelativeLayout>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/exposure_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            >

            <ImageView
                android:id="@+id/exposure_seekbar_text"
                android:contentDescription="@string/exposure_compensation"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:srcCompat="@drawable/ic_exposure_white_48dp"
                />

            <!-- alpha set as workaround for Android 7 bug where seekbar doesn't show when rotated -->
            <SeekBar
                android:id="@+id/exposure_seekbar"
                android:contentDescription="@string/exposure_compensation_seekbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/exposure_seekbar_text"
                android:layout_alignTop="@+id/exposure_seekbar_text"
                android:layout_alignBottom="@+id/exposure_seekbar_text"
                android:alpha="0.9"
                />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/manual_exposure_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            >

            <ImageView
                android:id="@+id/iso_seekbar_text"
                android:contentDescription="@string/iso"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:srcCompat="@drawable/iso_icon"
                />

            <!-- alpha set as workaround for Android 7 bug where seekbar doesn't show when rotated -->
            <SeekBar
                android:id="@+id/iso_seekbar"
                android:contentDescription="@string/iso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/iso_seekbar_text"
                android:layout_alignTop="@+id/iso_seekbar_text"
                android:layout_alignBottom="@+id/iso_seekbar_text"
                android:alpha="0.9"
                />

            <ImageView
                android:id="@+id/exposure_time_seekbar_text"
                android:contentDescription="@string/exposure_shutter_speed"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_below="@+id/iso_seekbar"
                app:srcCompat="@drawable/baseline_shutter_speed_white_48"
                />

            <!-- alpha set as workaround for Android 7 bug where seekbar doesn't show when rotated -->
            <SeekBar
                android:id="@+id/exposure_time_seekbar"
                android:contentDescription="@string/exposure_shutter_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/exposure_time_seekbar_text"
                android:layout_alignTop="@+id/exposure_time_seekbar_text"
                android:layout_alignBottom="@+id/exposure_time_seekbar_text"
                android:alpha="0.9"
                />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/manual_white_balance_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            >

            <ImageView
                android:id="@+id/white_balance_seekbar_text"
                android:contentDescription="@string/white_balance"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:srcCompat="@drawable/ic_colorize_white_48dp"
                />

            <!-- alpha set as workaround for Android 7 bug where seekbar doesn't show when rotated -->
            <SeekBar
                android:id="@+id/white_balance_seekbar"
                android:contentDescription="@string/white_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/white_balance_seekbar_text"
                android:layout_alignTop="@+id/white_balance_seekbar_text"
                android:layout_alignBottom="@+id/white_balance_seekbar_text"
                android:alpha="0.9"
                />

        </RelativeLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/locker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        />

    <ScrollView
        android:id="@+id/hide_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone"
        android:importantForAccessibility="no"
        />

    <!-- Zoom-Stufen und Moduswahl-Leiste (Phase 2, SPEC.md 4.5). Die Stufen-Buttons werden
         zur Laufzeit aus dem echten Zoom-Bereich der Kamera erzeugt, siehe ZoomStepper.java;
         positioniert wird beides rotationsbewusst in MainUI.layoutUI(), die
         app:layout_constraint*-Angaben hier sind nur ein Startwert. -->
    <!-- Die Zoom-Pille ist eine ZoomWheel-View (ein LinearLayout mit den Stufen-Buttons), die
         beim seitlichen Ziehen oder waehrend eines Pinch-Zooms zum Feinjustier-Rad wird
         (ui-spezifikation.md 3.2); das Badge darueber zeigt dabei den eingestellten Wert. -->
    <net.sourceforge.opencamera.ui.ZoomWheel
        android:id="@+id/zoom_stepper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/pill_background"
        android:contentDescription="@string/zoom_stepper"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/take_photo"
        android:layout_marginBottom="16dp"
        />

    <TextView
        android:id="@+id/zoom_badge"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center"
        android:background="@drawable/pill_selected_background"
        android:textColor="@color/md_dark_surface"
        android:textSize="13sp"
        android:textStyle="bold"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/zoom_stepper"
        />

    <!-- Pro-Panel (Kickoff redesign-pro-panel.md 3). Kein Blatt, sondern ein Overlay ueber dem
         Sucher: die Kamera bleibt sichtbar, der Sucher bekommt die Tipps daneben weiter. Die
         Pille traegt genau einen Regler - den des aktiven Reiters; der Regler selbst ist einer
         der vorhandenen SeekBars (R.id.exposure_seekbar usw.), der beim Oeffnen hier
         hineinwandert (ui/ProPanel.java). Position bestimmt MainUI.layoutUI() genauso wie bei
         der Zoom-Pille, damit beide an derselben Stelle sitzen. -->
    <FrameLayout
        android:id="@+id/pro_panel_pill"
        android:layout_width="288dp"
        android:layout_height="48dp"
        android:background="@drawable/pill_background"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            >

            <!-- Feinjustierung links: das Symbol des Reiters mit kleinem Minus (Referenz).
                 Bedient wird der Knopf in ui/ProPanel.java, nicht ueber android:onClick -
                 dort haengt auch das Symbol des jeweiligen Reiters dran. -->
            <FrameLayout
                android:id="@+id/pro_panel_minus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/pro_panel_minus"
                >

                <ImageView
                    android:id="@+id/pro_panel_minus_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"
                    />

                <TextView
                    android:id="@+id/pro_panel_minus_sign"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="6dp"
                    android:text="−"
                    android:textColor="@color/settings_sheet_button_glyph"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:importantForAccessibility="no"
                    />
            </FrameLayout>

            <!-- Der Regler des aktiven Reiters wird zur Laufzeit hier hineingehaengt; darunter
                 liegt das Massband (ui/RulerSlider.java), das nur zeichnet. -->
            <FrameLayout
                android:id="@+id/pro_panel_slider_holder"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                />

            <!-- Feinjustierung rechts: dasselbe Symbol mit kleinem Plus -->
            <FrameLayout
                android:id="@+id/pro_panel_plus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/pro_panel_plus"
                >

                <ImageView
                    android:id="@+id/pro_panel_plus_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"
                    />

                <TextView
                    android:id="@+id/pro_panel_plus_sign"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="6dp"
                    android:text="+"
                    android:textColor="@color/settings_sheet_button_glyph"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:importantForAccessibility="no"
                    />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Zurueck auf Automatik fuer den aktiven Reiter (Referenz: runder Knopf rechts NEBEN der
         Pille). Immer sichtbar (Falk 2026-09-21) - ein Druck holt den Standardwert zurueck.
         Beschriftet statt mit dem Pfeil-Symbol: der Reiter "Alle zuruecksetzen" traegt dasselbe
         Symbol, und zwei gleiche Zeichen im selben Panel waren nicht zu unterscheiden
         (Falk 2026-09-22). -->
    <TextView
        android:id="@+id/pro_panel_auto"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/settings_sheet_dock_button"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/pro_panel_auto_value"
        android:textColor="@color/settings_sheet_button_glyph"
        android:textSize="12sp"
        android:contentDescription="@string/pro_panel_auto"
        android:onClick="clickedProPanelAuto"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <!-- Hintergrundband der Reiter-Reihe (Referenz: die unterste Zone der Pro-Ansicht liegt auf
         einer eigenen dunklen Flaeche, Farbe wie das Einstellungen-Blatt - keine neue Farbe). -->
    <View
        android:id="@+id/pro_panel_sheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/settings_sheet_panel"
        android:visibility="gone"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <!-- Zieh-Balken ueber der Reiter-Reihe: dasselbe Griffstueck wie am Einstellungen-Blatt.
         Ein Wischen nach unten schliesst das Panel (Geste des Blattes). -->
    <View
        android:id="@+id/pro_panel_handle"
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:background="@color/settings_sheet_handle"
        android:visibility="gone"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <!-- Wert des aktiven Reglers, nur waehrend des Verstellens (wie das Zoom-Badge). -->
    <TextView
        android:id="@+id/pro_panel_badge"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center"
        android:background="@drawable/pill_selected_background"
        android:textColor="@color/md_dark_surface"
        android:textSize="13sp"
        android:textStyle="bold"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <!-- Reiter-Reihe am unteren Rand, an der Stelle der Modus-Leiste (die waehrend des offenen
         Panels ausgeblendet ist). Die Reiter baut ui/ProPanel.java. -->
    <HorizontalScrollView
        android:id="@+id/pro_panel_tabs_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <LinearLayout
            android:id="@+id/pro_panel_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            />
    </HorizontalScrollView>

    <!-- Die Fokus-Modi als Knopfreihe ueber der Reiter-Reihe, nur im Reiter "Fokus" sichtbar
         (Falk 2026-09-21). Die alte Icon-Leiste hatte fuer sie keinen Platz mehr, das
         Einstellungen-Blatt haette sie vergraben - der Reiter ist der Ort, an dem sie
         hingehoeren. Die Knoepfe baut ui/ProPanel.java aus den focus_mode_*-Arrays. -->
    <HorizontalScrollView
        android:id="@+id/pro_panel_focus_modes_scroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <LinearLayout
            android:id="@+id/pro_panel_focus_modes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/pill_background"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            />
    </HorizontalScrollView>

    <!-- Eine LinearLayout-Leiste (keine ScrollView). Das Fenster ist auf Hochformat gesperrt,
         die Leiste liegt also immer waagerecht; haelt man das Geraet quer, stehen ihre
         Beschriftungen quer - genau wie in der Referenz (ui-spezifikation.md Abschnitt 2),
         die Modus-Texte werden bewusst NICHT wie die Symbole zurueckgedreht. Der Abstand
         zwischen den Eintraegen kommt als Trenner (showDividers). -->
    <!-- Linker Dock-Button der untersten Zeile (Kickoff 2.1/3.1): Kreis 48 dp, Fuellung
         #333333, Icon settings_photo_camera weiss. Das 24-dp-Symbol bleibt durch das
         Innenabstand-Polster von 12 dp auf 24 dp und wird nicht auf den Kreis hochskaliert.
         Position setzt MainUI.layoutUI() (Zentrum 40 dp vom linken Rand, 85 dp von unten). -->
    <ImageButton
        android:id="@+id/settings_sheet_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:background="@drawable/settings_sheet_dock_button"
        android:src="@drawable/ms_settings_photo_camera"
        android:contentDescription="@string/settings_sheet_open"
        android:onClick="clickedSettingsSheet"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <!-- Der Stärke-Knopf im Zeitraffer/Zeitlupe (SPEC 4.6): belegt im Video den Platz des
         Pro-Panel-Knopfes (der dort aus ist) und zeigt Symbol und aktuellen Wert - wie in der
         Referenz (docs/design-reference/pixel-zeitraffer-zeitlupe-beschreibung.md 4). Die Chips
         baut MainUI, weil sie von der Kamera abhängen. -->
    <LinearLayout
        android:id="@+id/video_speed_button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/dock_pill_background"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:contentDescription="@string/video_speed_open"
        android:onClick="clickedVideoSpeed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" >

        <ImageView
            android:id="@+id/video_speed_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_timelapse_white_48dp" />

        <TextView
            android:id="@+id/video_speed_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/md_dark_on_surface"
            android:textSize="14sp"
            android:text="@string/video_speed_placeholder" />

    </LinearLayout>

    <!-- Die Stärke-Leiste: dieselbe dunkle Pille wie die Zoom-Pille, an deren Platz sie steht
         (Referenz: sie ersetzt sie, solange sie offen ist). Position setzt MainUI.layoutUI(),
         die Chips MainUI.buildVideoSpeedBar(). -->
    <LinearLayout
        android:id="@+id/video_speed_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/pill_background"
        android:divider="@drawable/mode_bar_gap"
        android:showDividers="middle"
        android:visibility="gone"
        android:contentDescription="@string/video_speed_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Rechter Dock-Button (K13, ui-spezifikation.md 7.1 Punkt 3): Spiegel des linken - Kreis
         48 dp, Fuellung #333333, Symbol "drei Reglerstifte". Die Detail-Spec nennt 40 dp; wie
         beim linken Knopf gilt der am Screenrecord gemessene Wert (Kickoff 3). Position setzt
         MainUI.layoutUI(). -->
    <ImageButton
        android:id="@+id/pro_panel_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:background="@drawable/settings_sheet_dock_button"
        android:src="@drawable/ms_tune"
        android:contentDescription="@string/pro_panel_open"
        android:onClick="clickedProPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <!-- Foto/Video-Umschalter aus der untersten Zeile der Referenz (Audit-Schritt 1 nimmt nur
         dieses eine Element vorweg, die Buttons links und rechts davon kommen mit Schritt 2).
         Größe und Ausrichtung bestimmt die View selbst, Position MainUI.layoutUI(). -->
    <net.sourceforge.opencamera.ui.PhotoVideoSwitch
        android:id="@+id/photo_video_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/switch_to_video"
        android:onClick="clickedSwitchVideo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <LinearLayout
        android:id="@+id/mode_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:divider="@drawable/mode_bar_gap"
        android:showDividers="middle"
        android:contentDescription="@string/mode_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/mode_bar_photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/md_dark_on_surface"
            android:textSize="14sp"
            android:text="@string/mode_bar_photo"
            />

        <TextView
            android:id="@+id/mode_bar_panorama"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/md_dark_on_surface"
            android:textSize="14sp"
            android:text="@string/photo_mode_panorama_full"
            />

        <!-- Die Video-Untermodi (SPEC 4.6). Sichtbarkeit und Hervorhebung setzt
             MainUI.updateModeBar(); im Fotomodus sind sie GONE. -->
        <TextView
            android:id="@+id/mode_bar_video"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/md_dark_on_surface"
            android:textSize="14sp"
            android:visibility="gone"
            android:text="@string/mode_bar_video"
            />

        <TextView
            android:id="@+id/mode_bar_slow_motion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/md_dark_on_surface"
            android:textSize="14sp"
            android:visibility="gone"
            android:text="@string/mode_bar_slow_motion"
            />

        <TextView
            android:id="@+id/mode_bar_timelapse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/md_dark_on_surface"
            android:textSize="14sp"
            android:visibility="gone"
            android:text="@string/mode_bar_timelapse"
            />

    </LinearLayout>

    <!-- Einstellungen-Blatt (Kickoff 3.2). Letztes Kind des Root-Layouts, damit es ueber allem
         liegt. settings_sheet ist der bildschirmfuellende Faenger: ein Tipp daneben schliesst
         das Blatt, und keine Beruehrung erreicht den Sucher darunter. Das Paneel
         (settings_sheet_panel) baut ui/SettingsSheet selbst auf - Groesse, Drehung und
         Translation setzt es je ui_rotation (Hochformat: 426,7 x 538 dp unten; Querformat:
         470,7 dp dick an der physischen Unterkante; auf dem Kopf um 180 Grad gedreht). -->
    <FrameLayout
        android:id="@+id/settings_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" >

        <FrameLayout
            android:id="@+id/settings_sheet_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
